{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Show",
  "description": "A declarative show description: what a `.json` show file deserializes into.",
  "type": "object",
  "properties": {
    "background": {
      "description": "Background color, `#RRGGBB` or `#RRGGBBAA`.",
      "type": "string",
      "default": "#000000"
    },
    "fonts": {
      "description": "Named text styles for text layers: a bitmap font plus colors.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/FontStyle"
      },
      "default": {}
    },
    "layers": {
      "description": "Layers that are always present, painted behind the active scene.",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Layer"
      }
    },
    "name": {
      "type": "string"
    },
    "output": {
      "description": "How rendered colors reach the display: full color by default, or\nquantized luminance tinted in one color (DMD style). Scenes can\noverride it.",
      "$ref": "#/$defs/Output",
      "default": {
        "mode": "rgb",
        "tint": null
      }
    },
    "scenes": {
      "description": "Switchable views; exactly one is active at a time (the first one\nwhen the show loads), entered by firing its trigger.",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Scene"
      }
    },
    "size": {
      "description": "Logical canvas size in pixels `[width, height]`. Hosts scale the\nrendered texture; content is authored against this space.\nCoordinates have their origin at the top-left corner: x grows\nright, y grows down.",
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint32",
        "minimum": 0
      },
      "maxItems": 2,
      "minItems": 2
    },
    "variables": {
      "description": "Declared variables and their initial values.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Value"
      },
      "default": {}
    }
  },
  "required": [
    "name",
    "size"
  ],
  "$defs": {
    "Align": {
      "description": "Where content sits in a box: one of nine positions.",
      "type": "string",
      "enum": [
        "top_left",
        "top",
        "top_right",
        "left",
        "center",
        "right",
        "bottom_left",
        "bottom",
        "bottom_right"
      ]
    },
    "Binding": {
      "description": "A permanent wiring of a property to a variable, evaluated every frame.\n\nNumeric properties take `variable * scale + offset`. The `text`\nproperty takes the variable as text: numbers get `scale`/`offset`\napplied, then `format`.",
      "type": "object",
      "properties": {
        "format": {
          "description": "How a number becomes text (text bindings only).",
          "$ref": "#/$defs/NumberFormat",
          "default": "plain"
        },
        "offset": {
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "property": {
          "$ref": "#/$defs/Property"
        },
        "scale": {
          "type": "number",
          "format": "double",
          "default": 1.0
        },
        "variable": {
          "type": "string"
        }
      },
      "required": [
        "property",
        "variable"
      ]
    },
    "Border": {
      "description": "An outline drawn around every glyph.",
      "type": "object",
      "properties": {
        "color": {
          "description": "`#RRGGBB`",
          "type": "string"
        },
        "width": {
          "description": "Outline width in pixels.",
          "type": "integer",
          "format": "uint32",
          "default": 1,
          "minimum": 0
        }
      },
      "required": [
        "color"
      ]
    },
    "Easing": {
      "description": "Easing applied to the segment that ends at the keyframe carrying it.",
      "type": "string",
      "enum": [
        "linear",
        "quad_in",
        "quad_out",
        "quad_in_out",
        "cubic_in",
        "cubic_out",
        "cubic_in_out",
        "step"
      ]
    },
    "FontStyle": {
      "description": "A text style: a bitmap font the host registered, tinted and optionally\noutlined.",
      "type": "object",
      "properties": {
        "border": {
          "anyOf": [
            {
              "$ref": "#/$defs/Border"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "color": {
          "description": "Glyph color multiplier, `#RRGGBB`; white keeps the font's colors.",
          "type": "string",
          "default": "#FFFFFF"
        },
        "file": {
          "description": "Name of the bitmap font as registered by the host with\n[`Engine::set_font`](crate::Engine::set_font) (by convention the\n`.fnt` file stem).",
          "type": "string"
        }
      },
      "required": [
        "file"
      ]
    },
    "Key": {
      "description": "A keyframe: at time `t` (seconds) the property reaches value `v`,\napproached with `ease` from the previous key.",
      "type": "object",
      "properties": {
        "ease": {
          "$ref": "#/$defs/Easing",
          "default": "linear"
        },
        "t": {
          "type": "number",
          "format": "double"
        },
        "v": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "t",
        "v"
      ]
    },
    "Layer": {
      "description": "One node in the show tree.",
      "type": "object",
      "properties": {
        "bindings": {
          "description": "Live property bindings: `property = variable * scale + offset`.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Binding"
          }
        },
        "name": {
          "type": "string"
        },
        "opacity": {
          "description": "Opacity in [0, 1], multiplied down the tree.",
          "type": "number",
          "format": "double",
          "default": 1.0
        },
        "scale": {
          "description": "Uniform scale of this layer's own geometry around its x/y origin\n(shape coordinates and sizes, image destination size). For images\nthe origin is the top-left corner, so scaling grows toward the\nbottom-right; keeping a scaled image centered means\ncounter-animating x/y (see the beacon example show). Not inherited\nby group children yet.",
          "type": "number",
          "format": "double",
          "default": 1.0
        },
        "timelines": {
          "description": "Keyframed animations on this layer's properties.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Timeline"
          }
        },
        "visible": {
          "type": "boolean",
          "default": true
        },
        "x": {
          "description": "Translation applied to this layer (and its subtree, for groups),\nin canvas coordinates (origin top-left, y down).",
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "y": {
          "type": "number",
          "format": "double",
          "default": 0.0
        }
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Layer"
              }
            },
            "type": {
              "type": "string",
              "const": "group"
            }
          },
          "required": [
            "type",
            "children"
          ]
        },
        {
          "type": "object",
          "properties": {
            "fill": {
              "type": "string"
            },
            "shape": {
              "$ref": "#/$defs/Shape"
            },
            "type": {
              "type": "string",
              "const": "shape"
            }
          },
          "required": [
            "type",
            "shape",
            "fill"
          ]
        },
        {
          "description": "A host-provided raster image, registered under `image` via\n[`Engine::set_image`](crate::Engine::set_image). Drawn with its\ntop-left corner at the layer's x/y (there is no anchor property\nyet); not yet registered images are skipped.",
          "type": "object",
          "properties": {
            "image": {
              "type": "string"
            },
            "size": {
              "description": "Destination size `[width, height]`; the image's natural size\nwhen omitted.",
              "type": [
                "array",
                "null"
              ],
              "default": null,
              "items": {
                "type": "number",
                "format": "double"
              },
              "maxItems": 2,
              "minItems": 2
            },
            "type": {
              "type": "string",
              "const": "image"
            }
          },
          "required": [
            "type",
            "image"
          ]
        },
        {
          "description": "Text in a bitmap font style from the show's `fonts`. With `size` the\ntext is aligned inside that box (its top-left corner at the layer's\nx/y); without, the box is the text's own size. Multi-line text\n(`\\n`) aligns each line on its own. Skipped while the style's font\nis not registered.",
          "type": "object",
          "properties": {
            "align": {
              "$ref": "#/$defs/Align",
              "default": "center"
            },
            "font": {
              "type": "string"
            },
            "size": {
              "type": [
                "array",
                "null"
              ],
              "default": null,
              "items": {
                "type": "number",
                "format": "double"
              },
              "maxItems": 2,
              "minItems": 2
            },
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "text"
            }
          },
          "required": [
            "type",
            "text",
            "font"
          ]
        }
      ],
      "required": [
        "name"
      ]
    },
    "NumberFormat": {
      "description": "Number to text conversion for text bindings.",
      "oneOf": [
        {
          "description": "Shortest form: `1500`, `2.5`.",
          "type": "string",
          "const": "plain"
        },
        {
          "description": "Rounded to an integer with comma thousands separators: `1,500`.",
          "type": "string",
          "const": "thousands"
        }
      ]
    },
    "Output": {
      "description": "Output color handling, applied to the finished frame.",
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/$defs/OutputMode",
          "default": "rgb"
        },
        "tint": {
          "description": "Color that full luminance maps to in the gray modes, `#RRGGBB`\n(white when omitted). Ignored in `rgb` mode.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      }
    },
    "OutputMode": {
      "description": "How the finished frame's colors are converted for the display.",
      "oneOf": [
        {
          "description": "Full color, unchanged.",
          "type": "string",
          "const": "rgb"
        },
        {
          "description": "Luminance quantized to 4 levels (2 bits), times the tint.",
          "type": "string",
          "const": "gray2"
        },
        {
          "description": "Luminance quantized to 16 levels (4 bits), times the tint.",
          "type": "string",
          "const": "gray4"
        }
      ]
    },
    "Property": {
      "description": "An animatable layer property.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "x",
            "y",
            "opacity",
            "scale"
          ]
        },
        {
          "description": "The text of a text layer; bindable, not animatable.",
          "type": "string",
          "const": "text"
        }
      ]
    },
    "Scene": {
      "description": "A switchable view of the show: its layers render only while it is the\nactive scene. Entering a scene (again) restarts it: timelines of the\nprevious scene stop, the entered scene's autoplay timelines start at 0.",
      "type": "object",
      "properties": {
        "layers": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Layer"
          }
        },
        "name": {
          "type": "string"
        },
        "output": {
          "description": "Output color handling while this scene is active; the show's when\nomitted.",
          "anyOf": [
            {
              "$ref": "#/$defs/Output"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "trigger": {
          "description": "Trigger name that enters this scene.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "required": [
        "name"
      ]
    },
    "Shape": {
      "description": "Vector shapes, in the layer's local coordinate space.",
      "oneOf": [
        {
          "description": "`[x, y, width, height]`",
          "type": "object",
          "properties": {
            "rect": {
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              },
              "maxItems": 4,
              "minItems": 4
            }
          },
          "additionalProperties": false,
          "required": [
            "rect"
          ]
        },
        {
          "description": "`[cx, cy, radius]`",
          "type": "object",
          "properties": {
            "circle": {
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              },
              "maxItems": 3,
              "minItems": 3
            }
          },
          "additionalProperties": false,
          "required": [
            "circle"
          ]
        }
      ]
    },
    "Timeline": {
      "description": "A keyframed animation over one or more properties of its layer.\n\nA timeline runs when it is `autoplay` and the show loads, or when the\nhost fires its `trigger`. While running it owns the properties it\nanimates: timeline values override bindings, which override base values.",
      "type": "object",
      "properties": {
        "autoplay": {
          "type": "boolean",
          "default": false
        },
        "loop": {
          "type": "boolean",
          "default": false
        },
        "name": {
          "type": "string"
        },
        "tracks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Track"
          }
        },
        "trigger": {
          "description": "Trigger name that (re)starts this timeline.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "required": [
        "name",
        "tracks"
      ]
    },
    "Track": {
      "type": "object",
      "properties": {
        "keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Key"
          }
        },
        "property": {
          "$ref": "#/$defs/Property"
        }
      },
      "required": [
        "property",
        "keys"
      ]
    },
    "Value": {
      "description": "A value a host can push into the engine, and the type show variables hold.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "number",
          "format": "double"
        },
        {
          "type": "string"
        }
      ]
    }
  }
}
