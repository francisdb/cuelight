{
  "$schema": "../../../schemas/show.schema.json",
  "format": 1,
  "name": "beacon",
  "size": [256, 256],
  "background": "#0A0F14",
  "layers": [
    {
      "name": "floor",
      "type": "shape",
      "shape": { "rect": [16, 200, 224, 8] },
      "fill": "#12331E"
    },
    {
      "name": "orb",
      "type": "image",
      "image": "orb",
      "size": [128, 128],
      "anchor": "center",
      "x": 128,
      "y": 128,
      "timelines": [
        {
          "name": "pulse",
          "autoplay": true,
          "loop": true,
          "tracks": [
            {
              "property": "scale",
              "keys": [
                { "t": 0.0, "v": 1.0 },
                { "t": 1.0, "v": 1.15 },
                { "t": 2.0, "v": 1.0 }
              ]
            }
          ]
        },
        {
          "name": "flash",
          "trigger": "flash",
          "tracks": [
            {
              "property": "opacity",
              "keys": [
                { "t": 0.0, "v": 0.15 },
                { "t": 0.35, "v": 1.0, "ease": "quad_out" }
              ]
            }
          ]
        }
      ]
    }
  ]
}
